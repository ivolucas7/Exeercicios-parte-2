void setup() {
  // Configura os pinos do 2 ao 11 como saídas
  pinMode(2, OUTPUT);
  pinMode(3, OUTPUT);
  pinMode(4, OUTPUT);
  pinMode(5, OUTPUT);
  pinMode(6, OUTPUT);
  pinMode(7, OUTPUT);
  pinMode(8, OUTPUT);
  pinMode(9, OUTPUT);
  pinMode(10, OUTPUT);
  pinMode(11, OUTPUT);
}

void loop() {
  // ACENDE PROGRESSIVAMENTE (um por um)
  digitalWrite(2, HIGH);  delay(300); // Liga o LED 1 e espera um pouco
  digitalWrite(3, HIGH);  delay(300); // Liga o LED 2
  digitalWrite(4, HIGH);  delay(300); // Liga o LED 3
  digitalWrite(5, HIGH);  delay(300); // Liga o LED 4
  digitalWrite(6, HIGH);  delay(300); // Liga o LED 5
  digitalWrite(7, HIGH);  delay(300); // Liga o LED 6
  digitalWrite(8, HIGH);  delay(300); // Liga o LED 7
  digitalWrite(9, HIGH);  delay(300); // Liga o LED 8
  digitalWrite(10, HIGH); delay(300); // Liga o LED 9
  digitalWrite(11, HIGH); delay(1000); // Liga o LED 10 e espera 1 segundo acesos

  // APAGA TODOS DE UMA VEZ
  digitalWrite(2, LOW);
  digitalWrite(3, LOW);
  digitalWrite(4, LOW);
  digitalWrite(5, LOW);
  digitalWrite(6, LOW);
  digitalWrite(7, LOW);
  digitalWrite(8, LOW);
  digitalWrite(9, LOW);
  digitalWrite(10, LOW);
  digitalWrite(11, LOW);
  
  delay(1000); // Espera 1 segundo apagado antes de reiniciar o ciclo
}
